# AquilaFAQ — Smart Student Learning System Configuration
# Copy this to .env and fill values. NEVER commit .env

# === LLM Provider ===
# Option A: OpenRouter — PRIMARY (recommended, free tier: nvidia/nemotron)
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-content-safety:free

# Option B: Felo OX Alpha (felo.ai)
# FELO_API_KEY=your_felo_api_key_here
# FELO_BASE_URL=https://openapi.felo.ai/api/v1
# FELO_MODEL=ox-alpha

# Option C: Tokenra OX Alpha — Fallback
# OX_API_KEY=your_tokenra_api_key_here
# OX_BASE_URL=https://tokenra.io/v1
# OX_MODEL=ox-alpha-2

# Option D: Gemini API (https://aistudio.google.com) — fallback / embeddings
GEMINI_API_KEY=your_gemini_api_key_here
# Optional overrides (defaults in app/config.py)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Force provider: "openrouter" or "felo" or "ox" or "gemini" or "auto" (default auto picks openrouter>felo>ox>gemini)
# LLM_PROVIDER=auto

# MongoDB (Local or Atlas)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# Auth — REQUIRED for production (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=change_me_generate_strong_secret

# Optional: environment
ENV=development
